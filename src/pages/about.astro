---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/CtaSection.astro';
import { businessConfig } from '../data/businessConfig';

const focusAreas = [
  "English for Specific Purposes (ESP)",
  "Communication for Educators",
  "Corporate English & Workplace Discourse",
  "Workplace Communication & Etiquette",
  "Professional Speaking & Intelligibility",
  "Practical, Role-Based Language Development"
];
---

<Layout
  title="Meet Chriselle Dmello | The English Practice"
  description="Meet Chriselle Dmello, English Language Teaching Specialist with a Master's in English Language Teaching, leading The English Practice."
  currentPath="/about"
>
  
  <!-- HERO SECTION -->
  <section class="bg-gradient-to-b from-[#F7F4EE] via-[#FAF8F5] to-white pt-14 pb-20 border-b border-[#E2DDD2]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left: Headline & Bio Intro -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#153D40]/10 text-[#153D40] text-xs font-semibold uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-[#C9916C]"></span>
            About the Trainer
          </div>

          <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-[#153D40] font-bold tracking-tight leading-tight">
            Meet {businessConfig.trainerName}<span class="text-[#C9916C]">.</span>
          </h1>

          <div class="space-y-1">
            <p class="font-serif text-xl sm:text-2xl text-[#153D40] font-medium">
              {businessConfig.trainerTitle}
            </p>
            <p class="text-base font-semibold text-[#C9916C]">
              {businessConfig.trainerQualification}
            </p>
          </div>

          <div class="space-y-4 text-base sm:text-lg text-[#667378] leading-relaxed pt-2">
            <p>
              Chriselle Dmello is the trainer behind The English Practice. With a Master's in English Language Teaching, she brings a specialist academic foundation to her work in English for Specific Purposes.
            </p>
            <p class="text-[#212A32] font-medium">
              The English Practice focuses on practical language development for educators and working professionals, connecting English learning with the communication situations people encounter in their professional lives.
            </p>
          </div>

          <div class="pt-4 flex flex-wrap gap-4">
            <a
              href="/contact"
              class="inline-flex items-center justify-center px-6 py-3.5 rounded-lg text-sm font-semibold text-white bg-[#153D40] hover:bg-[#1E5155] active:bg-[#0E292B] shadow-sm transition-colors"
            >
              <span>Request a Training Consultation</span>
              <svg class="ml-2 w-4 h-4 text-[#E2B596]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Right: Editorial Portrait Composition -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="w-full max-w-md bg-white rounded-3xl border border-[#E2DDD2] p-8 shadow-sm space-y-6">
            
            <!-- Monogram Frame / Configurable Photo Slot -->
            <div class="w-full h-72 rounded-2xl bg-[#153D40] flex flex-col items-center justify-center text-center p-6 text-[#F7F4EE] relative overflow-hidden">
              <div class="absolute -right-12 -top-12 w-40 h-40 rounded-full border border-white/10 pointer-events-none"></div>
              <div class="absolute -left-12 -bottom-12 w-40 h-40 rounded-full border border-white/10 pointer-events-none"></div>
              <span class="font-serif text-6xl font-bold tracking-tight mb-2 text-[#E2B596]">CD</span>
              <span class="font-serif text-xl font-bold text-white tracking-wide">{businessConfig.trainerName}</span>
              <span class="text-xs text-[#A2B8B9] uppercase tracking-wider mt-1">{businessConfig.trainerTitle}</span>
              <div class="mt-4 px-3 py-1 rounded bg-[#0E292B] border border-[#1E5155] text-[11px] text-[#E2B596]">
                {businessConfig.trainerQualification}
              </div>
            </div>

            <!-- Factual Credential Badges -->
            <div class="space-y-3 pt-2">
              <div class="flex items-center justify-between text-xs py-2 border-b border-[#E2DDD2]">
                <span class="text-[#667378]">Academic Foundation:</span>
                <span class="font-medium text-[#153D40]">Master's in ELT</span>
              </div>
              <div class="flex items-center justify-between text-xs py-2 border-b border-[#E2DDD2]">
                <span class="text-[#667378]">Specialisation:</span>
                <span class="font-medium text-[#153D40]">English for Specific Purposes</span>
              </div>
              <div class="flex items-center justify-between text-xs py-2">
                <span class="text-[#667378]">Confirmed Formats:</span>
                <span class="font-medium text-[#153D40]">Online · 1-to-1 · Group</span>
              </div>
            </div>

          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- TEACHING PHILOSOPHY -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#153D40]/5 border border-[#153D40]/15 text-[#153D40] text-xs font-semibold uppercase tracking-wider mb-4">
          <span class="w-2 h-2 rounded-full bg-[#C9916C]"></span>
          Educational Philosophy
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl text-[#153D40] font-bold tracking-tight">
          Language learning should have a purpose.
        </h2>
      </div>

      <div class="p-8 sm:p-12 rounded-2xl bg-[#FAF8F5] border border-[#E2DDD2] space-y-6 text-base sm:text-lg text-[#212A32] leading-relaxed">
        <p>
          English communication develops meaningfully when learners have opportunities to connect language with situations that matter to them.
        </p>
        <p>
          A teacher may need to explain a concept more clearly. A corporate professional may need to contribute confidently during a meeting. A manager may need to deliver constructive feedback.
        </p>
        <p class="font-serif text-xl sm:text-2xl text-[#153D40] italic pt-2">
          "These situations call for communication practice that is relevant, practical and thoughtful."
        </p>
      </div>

    </div>
  </section>

  <!-- AREAS OF FOCUS -->
  <section class="py-20 bg-[#FAF8F5] border-t border-[#E2DDD2]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mb-12">
        <h2 class="font-serif text-3xl sm:text-4xl text-[#153D40] font-bold tracking-tight mb-4">
          Core Areas of Specialisation
        </h2>
        <p class="text-base text-[#667378]">
          Grounded in English Language Teaching pedagogy and applied directly to practical professional environments.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {focusAreas.map((area, idx) => (
          <div class="p-6 rounded-xl bg-white border border-[#E2DDD2] hover:border-[#C9916C] transition-all">
            <span class="font-mono text-xs text-[#C9916C] font-bold block mb-2">0{idx + 1}</span>
            <h3 class="font-serif text-lg font-bold text-[#153D40]">
              {area}
            </h3>
          </div>
        ))}
      </div>

      <!-- Action Buttons -->
      <div class="mt-14 p-8 rounded-2xl bg-white border border-[#E2DDD2] flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <h3 class="font-serif text-xl font-bold text-[#153D40] mb-1">
            Explore the Training Programmes
          </h3>
          <p class="text-xs sm:text-sm text-[#667378]">
            Discover purpose-built syllabi for educators and corporate professionals.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href="/english-for-teachers"
            class="px-5 py-2.5 rounded-lg text-sm font-semibold text-white bg-[#153D40] hover:bg-[#1E5155] transition-colors"
          >
            English for Educators
          </a>
          <a
            href="/corporate-english"
            class="px-5 py-2.5 rounded-lg text-sm font-semibold text-[#153D40] bg-[#FAF8F5] hover:bg-[#ECE7DC] border border-[#E2DDD2] transition-colors"
          >
            Corporate English
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- FINAL CTA -->
  <CtaSection
    headline="Strong ideas deserve clear communication."
    description="Connect with Chriselle Dmello to discuss communication development for your organisation or individual growth."
    primaryCtaText="Request a Training Consultation"
    primaryCtaHref="/contact"
  />

</Layout>
