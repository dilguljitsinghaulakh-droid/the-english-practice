---
import { approachSteps } from '../data/siteContent';

interface Props {
  showCta?: boolean;
}

const { showCta = true } = Astro.props;
---

<div class="space-y-12">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 relative">
    {approachSteps.map((step) => (
      <div class="relative bg-white rounded-2xl border border-[#E2DDD2] p-6 sm:p-7 flex flex-col justify-between hover:border-[#C9916C] transition-all duration-200 hover:shadow-sm">
        
        <!-- Step Header -->
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="font-serif text-3xl font-extrabold text-[#C9916C]">
              {step.step}
            </span>
            <span class="text-[11px] font-semibold tracking-wider uppercase text-[#667378] bg-[#FAF8F5] border border-[#E2DDD2] px-2.5 py-1 rounded">
              Phase {step.step}
            </span>
          </div>

          <h3 class="font-serif text-xl font-bold text-[#153D40] mb-1">
            {step.title}
          </h3>
          <p class="text-xs font-medium text-[#C9916C] mb-3">
            {step.subtitle}
          </p>

          <p class="text-sm text-[#667378] leading-relaxed mb-6">
            {step.description}
          </p>
        </div>

        <!-- Key Activities -->
        <div class="pt-4 border-t border-[#E2DDD2]/60">
          <span class="text-[11px] uppercase tracking-wider font-semibold text-[#153D40] block mb-2">
            Key Practical Elements:
          </span>
          <ul class="space-y-1 text-xs text-[#212A32]">
            {step.keyActivities.map((act) => (
              <li class="flex items-start gap-1.5">
                <span class="text-[#C9916C] font-bold">›</span>
                <span>{act}</span>
              </li>
            ))}
          </ul>
        </div>

      </div>
    ))}
  </div>

  {showCta && (
    <div class="text-center pt-4">
      <a
        href="/our-approach"
        class="inline-flex items-center text-sm font-semibold text-[#153D40] hover:text-[#C9916C] transition-colors gap-2"
      >
        <span>Discover Our Complete Learning Methodology</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  )}
</div>
