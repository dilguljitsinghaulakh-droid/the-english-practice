            <div class="w-48 h-56 sm:w-56 sm:h-64 rounded-2xl bg-[#153D40] border-4 border-[#FAF8F5] shadow-md flex flex-col items-center justify-center p-6 text-center text-[#F7F4EE] relative overflow-hidden">
              <div class="absolute -right-8 -top-8 w-24 h-24 rounded-full border border-white/10 pointer-events-none"></div>
              <span class="font-serif text-5xl font-bold tracking-tight mb-2 text-[#E2B596]">CD</span>
              <span class="font-serif text-base font-semibold text-white">{businessConfig.trainerName}</span>
              <span class="text-[11px] text-[#A2B8B9] uppercase tracking-wider mt-1">{businessConfig.trainerTitle}</span>
            </div>
          </div>

          <!-- Biography & Credentials -->
          <div class="md:col-span-7 space-y-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#C9916C]/15 text-[#B37A55] text-xs font-semibold uppercase tracking-wider">
