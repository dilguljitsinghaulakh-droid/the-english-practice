            <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#153D40]">
              Meet {businessConfig.trainerName}
            </h2>

            <p class="text-sm font-semibold text-[#C9916C]">
              {businessConfig.trainerQualification}
            </p>

            <div class="space-y-3 text-sm sm:text-base text-[#667378] leading-relaxed">
              <p>
                Chriselle Dmello is the trainer behind The English Practice. With a Master's in English Language Teaching, she brings a specialist academic foundation to her work in English for Specific Purposes.
              </p>
              <p>
                The English Practice focuses on practical language development for educators and working professionals, connecting English learning with the communication situations people encounter in their professional lives.
              </p>
            </div>

            <div class="pt-4">
              <a
                href="/about"
                class="inline-flex items-center text-sm font-semibold text-[#153D40] hover:text-[#C9916C] transition-colors"
              >
                <span>Learn More About Chriselle & Our Approach</span>
                <span class="ml-1.5 text-lg">→</span>
              </a>
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- SECTION 9 — FAQ PREVIEW -->
  <section class="py-20 bg-white border-t border-[#E2DDD2]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mx-auto text-center mb-14">
