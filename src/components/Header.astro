---
import { navItems } from '../data/siteContent';
import { businessConfig } from '../data/businessConfig';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="sticky top-0 z-50 bg-[#F7F4EE]/95 backdrop-blur-md border-b border-[#E2DDD2] transition-colors duration-200">
  <!-- Top notification/eyebrow bar -->
  <div class="bg-[#153D40] text-[#F7F4EE] text-xs py-1.5 px-4 sm:px-6">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-1 text-center sm:text-left">
      <span class="tracking-wide font-medium">
        Professional English Communication & Language Development · With {businessConfig.trainerName}
      </span>
      <span class="text-[#E2B596] font-medium hidden md:inline">
        Online · One-to-One · Group Training
      </span>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Wordmark Logo -->
      <a href="/" class="group flex flex-col focus:outline-none focus-visible:ring-2 focus-visible:ring-[#C9916C] rounded p-1">
        <span class="font-serif text-2xl sm:text-2xl font-bold tracking-tight text-[#153D40] transition-colors group-hover:text-[#1E5155]">
          The English Practice<span class="text-[#C9916C]">.</span>
        </span>
        <span class="text-[11px] font-sans tracking-wider uppercase text-[#667378] font-medium transition-colors group-hover:text-[#212A32]">
          {businessConfig.tagline}
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center space-x-1 xl:space-x-2" aria-label="Main Navigation">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-3 py-2 rounded-md text-sm font-medium transition-all duration-150 relative ${
                isActive
                  ? 'text-[#153D40] font-semibold bg-[#153D40]/5'
                  : 'text-[#212A32] hover:text-[#153D40] hover:bg-[#153D40]/5'
              }`}
              aria-current={isActive ? 'page' : undefined}
            >
              {item.label}
              {isActive && (
                <span class="absolute bottom-1 left-3 right-3 h-0.5 bg-[#C9916C] rounded-full"></span>
              )}
            </a>
          );
        })}
      </nav>

      <!-- CTA Button Desktop -->
      <div class="hidden lg:flex items-center space-x-4">
        <a
          href="/contact"
          class="inline-flex items-center justify-center px-4 py-2.5 text-sm font-medium rounded-lg text-white bg-[#153D40] hover:bg-[#1E5155] active:bg-[#0E292B] shadow-sm hover:shadow transition-all duration-200 border border-transparent shrink-0"
        >
          <span>Request a Consultation</span>
          <svg class="ml-2 w-4 h-4 text-[#E2B596]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex lg:hidden items-center">
        <button
          type="button"
          id="mobile-menu-button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open main menu"
          class="p-2 rounded-lg text-[#212A32] hover:text-[#153D40] hover:bg-[#153D40]/5 focus:outline-none focus:ring-2 focus:ring-[#C9916C]"
        >
          <!-- Hamburger Icon -->
          <svg id="hamburger-icon" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- Close Icon -->
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Drawer / Dropdown -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-[#E2DDD2] bg-[#FAF8F5] px-4 pt-3 pb-6 space-y-2 shadow-lg"
  >
    <div class="space-y-1">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-colors ${
              isActive
                ? 'bg-[#153D40] text-white'
                : 'text-[#212A32] hover:bg-[#153D40]/10 hover:text-[#153D40]'
            }`}
            aria-current={isActive ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </div>

    <div class="pt-4 border-t border-[#E2DDD2]">
      <a
        href="/contact"
        class="w-full flex items-center justify-center px-4 py-3 rounded-lg text-base font-medium text-white bg-[#153D40] hover:bg-[#1E5155] active:bg-[#0E292B] shadow-sm transition-colors"
      >
        <span>Request a Consultation</span>
        <svg class="ml-2 w-5 h-5 text-[#E2B596]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
      <p class="mt-2 text-center text-xs text-[#667378]">
        Online · One-to-One · Group Training
      </p>
    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (!button || !menu || !hamburgerIcon || !closeIcon) return;

    button.addEventListener('click', () => {
      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      hamburgerIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    // Close on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        button.setAttribute('aria-expanded', 'false');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        button.focus();
      }
    });
  }

  // Run on page load
  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
