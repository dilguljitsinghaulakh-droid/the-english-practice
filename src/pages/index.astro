      <div class="bg-white rounded-2xl border border-[#E2DDD2] p-8 sm:p-12 lg:p-16 max-w-4xl mx-auto shadow-sm">
        
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-center">
          
          <!-- Trainer Portrait Placeholder / Monogram Card -->
