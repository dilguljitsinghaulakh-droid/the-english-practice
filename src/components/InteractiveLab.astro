---
import { communicationLabData } from '../data/siteContent';
---

<section id="communication-lab" class="py-20 bg-white border-y border-[#E2DDD2]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#153D40]/5 border border-[#153D40]/15 text-[#153D40] text-xs font-semibold uppercase tracking-wider mb-4">
        <span class="w-2 h-2 rounded-full bg-[#C9916C]"></span>
        Interactive Communication Lab
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl text-[#153D40] font-bold tracking-tight mb-4">
        Small changes. Clearer communication.
      </h2>
      <p class="text-base sm:text-lg text-[#667378] leading-relaxed">
        Explore how more specific and thoughtful language can improve everyday professional communication across teaching and corporate environments.
      </p>
    </div>

    <!-- Audience Segment Tabs -->
    <div class="flex justify-center mb-8">
      <div class="inline-flex p-1.5 rounded-xl bg-[#FAF8F5] border border-[#E2DDD2] shadow-inner" role="tablist" aria-label="Audience Segments">
        <button
          type="button"
          role="tab"
          id="tab-btn-educators"
          aria-selected="true"
          aria-controls="panel-educators"
          class="lab-audience-tab px-6 py-2.5 rounded-lg text-sm font-semibold transition-all duration-200 bg-[#153D40] text-white shadow"
          data-audience="educators"
        >
          For Educators
        </button>
        <button
          type="button"
          role="tab"
          id="tab-btn-professionals"
          aria-selected="false"
          aria-controls="panel-professionals"
          class="lab-audience-tab px-6 py-2.5 rounded-lg text-sm font-medium transition-all duration-200 text-[#667378] hover:text-[#153D40]"
          data-audience="professionals"
        >
          For Corporate Professionals
        </button>
      </div>
    </div>

    <!-- Scenario Selector Pills -->
    <div class="flex flex-wrap justify-center gap-2 sm:gap-3 mb-10" id="scenario-selector-container">
      <!-- Injected or toggled by script -->
      {communicationLabData.map((item, idx) => (
        <button
          type="button"
          class={`scenario-pill px-4 py-2 rounded-lg text-xs sm:text-sm font-medium transition-all duration-150 border ${
            item.category === 'educators' ? 'inline-flex' : 'hidden'
          } ${
            idx === 0
              ? 'bg-[#153D40] text-white border-[#153D40] shadow-sm'
              : 'bg-[#FAF8F5] text-[#212A32] border-[#E2DDD2] hover:border-[#C9916C] hover:bg-white'
          }`}
          data-id={item.id}
          data-audience={item.category}
        >
          {item.scenarioTitle}
        </button>
      ))}
    </div>

    <!-- Interactive Comparison Stage -->
    <div class="max-w-4xl mx-auto bg-[#FAF8F5] rounded-2xl border border-[#E2DDD2] p-6 sm:p-10 shadow-sm relative overflow-hidden">
      
      <!-- Top context banner -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 mb-8 border-b border-[#E2DDD2] gap-2">
        <div>
          <span class="text-xs uppercase tracking-wider font-semibold text-[#C9916C]" id="lab-context-label">
            Scenario Focus
          </span>
          <h3 class="font-serif text-2xl font-bold text-[#153D40]" id="lab-title">
            Classroom Instructions
          </h3>
        </div>
        <p class="text-xs sm:text-sm text-[#667378] max-w-sm sm:text-right" id="lab-context-desc">
          Setting clear timeframes and behavioral expectations for an in-class activity.
        </p>
      </div>

      <!-- Before and After Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        
        <!-- Left: Less Specific -->
        <div class="rounded-xl border border-red-200 bg-white p-6 shadow-xs flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-red-700 bg-red-50 border border-red-200 px-2.5 py-1 rounded-md">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <span id="lab-less-label">Less specific</span>
              </span>
              <span class="text-[11px] text-[#667378] uppercase tracking-wider font-medium">Original statement</span>
            </div>
            <div class="p-4 rounded-lg bg-red-50/50 border border-red-100 text-[#212A32] font-mono text-base mb-4 leading-relaxed italic" id="lab-less-text">
              "Complete this quickly."
            </div>
          </div>
          <p class="text-xs text-[#667378] border-t border-red-100 pt-3">
            Can create ambiguity regarding timeline, expectations, and how to seek support.
          </p>
        </div>

        <!-- Right: Clearer Alternative -->
        <div class="rounded-xl border border-emerald-300 bg-white p-6 shadow-xs flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-800 bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-md">
                <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span id="lab-clearer-label">Clearer alternative</span>
              </span>
              <span class="text-[11px] text-[#667378] uppercase tracking-wider font-medium">Role-tailored alternative</span>
            </div>
            <div class="p-4 rounded-lg bg-emerald-50/50 border border-emerald-200 text-[#153D40] font-medium text-base mb-4 leading-relaxed" id="lab-clearer-text">
              "You have three minutes to complete the activity. Please raise your hand if you need help."
            </div>
          </div>
          <p class="text-xs text-[#153D40] font-medium border-t border-emerald-100 pt-3 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
            <span id="lab-takeaway">State the duration, the specific action required, and how to ask for assistance.</span>
          </p>
        </div>

      </div>

      <!-- Explanation Panel -->
      <div class="bg-white rounded-xl border border-[#E2DDD2] p-5">
        <div class="flex items-start gap-3">
          <div class="w-8 h-8 rounded-lg bg-[#C9916C]/15 text-[#C9916C] flex items-center justify-center shrink-0 mt-0.5 font-serif font-bold text-base">
            ✦
          </div>
          <div>
            <h4 class="text-xs font-semibold text-[#153D40] uppercase tracking-wider mb-1">
              Communication Rationale
            </h4>
            <p class="text-sm text-[#212A32] leading-relaxed" id="lab-explanation">
              Clear instructions help learners understand the task, available time and expected response.
            </p>
          </div>
        </div>
      </div>

      <!-- Footnote Disclaimer -->
      <p class="text-center text-xs text-[#667378] mt-6 italic">
        Note: Examples illustrate possible communication choices. Appropriate wording depends on context, relationships and communication goals.
      </p>

    </div>
  </div>
</section>

<!-- Pure Client-side Vanilla Script -->
<script is:inline define:vars={{ labItems: communicationLabData }}>
  (function () {
    let currentAudience = 'educators';
    let currentId = 'edu-1';

    const tabEducators = document.getElementById('tab-btn-educators');
    const tabProfessionals = document.getElementById('tab-btn-professionals');
    const pills = document.querySelectorAll('.scenario-pill');

    const titleEl = document.getElementById('lab-title');
    const contextDescEl = document.getElementById('lab-context-desc');
    const lessLabelEl = document.getElementById('lab-less-label');
    const lessTextEl = document.getElementById('lab-less-text');
    const clearerLabelEl = document.getElementById('lab-clearer-label');
    const clearerTextEl = document.getElementById('lab-clearer-text');
    const explanationEl = document.getElementById('lab-explanation');
    const takeawayEl = document.getElementById('lab-takeaway');

    function renderActiveScenario(id) {
      const item = labItems.find(x => x.id === id);
      if (!item) return;

      if (titleEl) titleEl.textContent = item.scenarioTitle;
      if (contextDescEl) contextDescEl.textContent = item.context;
      if (lessLabelEl) lessLabelEl.textContent = item.lessEffectiveLabel;
      if (lessTextEl) lessTextEl.textContent = `"${item.lessEffective}"`;
      if (clearerLabelEl) clearerLabelEl.textContent = item.clearerLabel;
      if (clearerTextEl) clearerTextEl.textContent = `"${item.clearer}"`;
      if (explanationEl) explanationEl.textContent = item.explanation;
      if (takeawayEl) takeawayEl.textContent = item.takeaway;

      pills.forEach(p => {
        const isCurrent = p.getAttribute('data-id') === id;
        if (isCurrent) {
          p.classList.remove('bg-[#FAF8F5]', 'text-[#212A32]', 'border-[#E2DDD2]');
          p.classList.add('bg-[#153D40]', 'text-white', 'border-[#153D40]', 'shadow-sm');
        } else {
          p.classList.add('bg-[#FAF8F5]', 'text-[#212A32]', 'border-[#E2DDD2]');
          p.classList.remove('bg-[#153D40]', 'text-white', 'border-[#153D40]', 'shadow-sm');
        }
      });
    }

    function switchAudience(audience) {
      currentAudience = audience;
      if (audience === 'educators') {
        tabEducators.classList.add('bg-[#153D40]', 'text-white', 'shadow');
        tabEducators.classList.remove('text-[#667378]');
        tabEducators.setAttribute('aria-selected', 'true');

        tabProfessionals.classList.remove('bg-[#153D40]', 'text-white', 'shadow');
        tabProfessionals.classList.add('text-[#667378]');
        tabProfessionals.setAttribute('aria-selected', 'false');
      } else {
        tabProfessionals.classList.add('bg-[#153D40]', 'text-white', 'shadow');
        tabProfessionals.classList.remove('text-[#667378]');
        tabProfessionals.setAttribute('aria-selected', 'true');

        tabEducators.classList.remove('bg-[#153D40]', 'text-white', 'shadow');
        tabEducators.classList.add('text-[#667378]');
        tabEducators.setAttribute('aria-selected', 'false');
      }

      // Filter visible pills
      let firstVisibleId = null;
      pills.forEach(p => {
        if (p.getAttribute('data-audience') === audience) {
          p.classList.remove('hidden');
          p.classList.add('inline-flex');
          if (!firstVisibleId) firstVisibleId = p.getAttribute('data-id');
        } else {
          p.classList.add('hidden');
          p.classList.remove('inline-flex');
        }
      });

      if (firstVisibleId) {
        currentId = firstVisibleId;
        renderActiveScenario(firstVisibleId);
      }
    }

    if (tabEducators) {
      tabEducators.addEventListener('click', () => switchAudience('educators'));
    }
    if (tabProfessionals) {
      tabProfessionals.addEventListener('click', () => switchAudience('professionals'));
    }

    pills.forEach(p => {
      p.addEventListener('click', () => {
        const id = p.getAttribute('data-id');
        if (id) {
          currentId = id;
          renderActiveScenario(id);
        }
      });
    });
  })();
</script>
