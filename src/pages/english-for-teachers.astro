---
import Layout from '../layouts/Layout.astro';
import ExpandableModuleCard from '../components/ExpandableModuleCard.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CtaSection from '../components/CtaSection.astro';
import { educatorModules, globalFaqs, trainingFormats } from '../data/siteContent';

const educatorFaqs = globalFaqs.filter(f => f.category === 'educators' || f.category === 'general').slice(0, 5);

const targetAudienceList = [
  {
    title: "English-Language Teachers",
    description: "Refine instructional language, discourse nuances, and feedback precision in the language classroom."
  },
  {
    title: "Subject Teachers (English Medium)",
    description: "For Mathematics, Science, and Social Studies educators teaching content through the English language."
  },
  {
    title: "Primary & Secondary School Faculty",
    description: "Develop clear pacing, age-appropriate instructional scaffolding, and classroom management instructions."
  },
  {
    title: "Academic Coordinators & Heads of Dept",
    description: "Strengthen meeting moderation, curriculum briefings, faculty feedback, and academic correspondence."
  },
  {
    title: "Individual Educators Seeking Growth",
    description: "Build personal speaking confidence, pronunciation clarity, and professional presentation competence."
  },
  {
    title: "Educational Institutions & Schools",
    description: "Whole-school or departmental group cohorts aligned with school curriculum standards and communication goals."
  }
];
---

<Layout
  title="English Communication Training for Teachers | The English Practice"
  description="Practical English communication development for teachers and educators. Classroom instruction, student engagement, parent meetings, and academic English led by Chriselle Dmello."
  currentPath="/english-for-teachers"
>
  
  <!-- HERO SECTION -->
  <section class="bg-gradient-to-b from-[#F7F4EE] via-[#FAF8F5] to-white pt-14 pb-20 border-b border-[#E2DDD2]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#153D40]/10 text-[#153D40] text-xs font-semibold uppercase tracking-wider mb-6">
          <span class="w-2 h-2 rounded-full bg-[#C9916C]"></span>
          English for Educators
        </div>

        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-[#153D40] font-bold tracking-tight leading-tight mb-6">
          Teach with clarity. Connect with confidence.
        </h1>

        <div class="space-y-4 text-base sm:text-lg text-[#667378] leading-relaxed mb-8">
          <p>
            Effective teaching involves more than subject knowledge. It also involves explaining concepts clearly, guiding discussions, giving feedback and communicating with students, parents and colleagues.
          </p>
          <p class="font-medium text-[#212A32]">
            At The English Practice, educator training focuses on the English communication skills used in everyday teaching and professional responsibilities.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-6 py-3.5 rounded-lg text-sm font-semibold text-white bg-[#153D40] hover:bg-[#1E5155] active:bg-[#0E292B] shadow-sm hover:shadow transition-all"
          >
            <span>Discuss Educator Training</span>
            <svg class="ml-2 w-4 h-4 text-[#E2B596]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="#modules"
            class="inline-flex items-center justify-center px-6 py-3.5 rounded-lg text-sm font-semibold text-[#153D40] bg-white hover:bg-[#FAF8F5] border border-[#E2DDD2] shadow-2xs transition-all"
          >
            <span>Explore Training Modules</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- WHO IS THIS FOR? -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mb-12">
        <h2 class="font-serif text-3xl sm:text-4xl text-[#153D40] font-bold tracking-tight mb-4">
          Who can benefit from educator communication training?
        </h2>
        <p class="text-base text-[#667378]">
          Our programmes are tailored for educators across diverse disciplines, school levels, and administrative roles. You do not need to be an English language teacher to benefit.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {targetAudienceList.map((item) => (
          <div class="p-6 rounded-xl bg-[#FAF8F5] border border-[#E2DDD2] hover:border-[#153D40] transition-colors">
            <h3 class="font-serif text-lg font-bold text-[#153D40] mb-2">
              {item.title}
            </h3>
            <p class="text-sm text-[#667378] leading-relaxed">
              {item.description}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- SIX TRAINING MODULES -->
  <section id="modules" class="py-20 bg-[#FAF8F5] border-t border-[#E2DDD2]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mx-auto text-center mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#153D40]/5 border border-[#153D40]/15 text-[#153D40] text-xs font-semibold uppercase tracking-wider mb-4">
          <span class="w-2 h-2 rounded-full bg-[#C9916C]"></span>
          Structured Modules
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl text-[#153D40] font-bold tracking-tight mb-4">
          Educator Communication Modules
        </h2>
        <p class="text-base sm:text-lg text-[#667378]">
          Explore the practical curriculum units developed specifically for teaching and institutional responsibilities.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {educatorModules.map((mod) => (
          <ExpandableModuleCard
            id={mod.id}
            number={mod.number}
            title={mod.title}
            headline={mod.headline}
            points={mod.focusPoints}
            pointsLabel="Key Learning Points"
            practicalLabel="Scenario Simulation"
            practicalContent={mod.practicalAspect}
          />
        ))}
      </div>

    </div>
  </section>

  <!-- DUAL PROVISION: SCHOOLS & INDIVIDUALS -->
  <section class="py-20 bg-white border-t border-[#E2DDD2]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        
        <!-- School & Institution Training -->
        <div class="bg-[#FAF8F5] rounded-2xl border border-[#E2DDD2] p-8 sm:p-10 flex flex-col justify-between">
          <div class="space-y-4">
            <span class="inline-block px-3 py-1 rounded-md text-xs font-bold uppercase tracking-wider bg-[#153D40] text-white">
              Institutional Cohorts
            </span>
            <h3 class="font-serif text-2xl sm:text-3xl font-bold text-[#153D40]">
              Support communication development across your teaching team.
            </h3>
            <div class="space-y-3 text-sm sm:text-base text-[#667378] leading-relaxed">
              <p>
                Schools and educational institutions may have different training priorities depending on curriculum, teaching context, staff experience and language requirements.
              </p>
              <p>
                Training needs can be discussed to identify relevant learning areas and a suitable group-training structure.
              </p>
            </div>
          </div>

          <div class="pt-6 mt-6 border-t border-[#E2DDD2]">
            <a
              href="/contact"
              class="inline-flex items-center text-sm font-semibold text-[#153D40] hover:text-[#C9916C] transition-colors"
            >
              <span>Discuss Training for Your School</span>
              <span class="ml-1.5 text-lg">→</span>
            </a>
          </div>
        </div>

        <!-- Individual Teacher Training -->
        <div class="bg-[#FAF8F5] rounded-2xl border border-[#E2DDD2] p-8 sm:p-10 flex flex-col justify-between">
          <div class="space-y-4">
            <span class="inline-block px-3 py-1 rounded-md text-xs font-bold uppercase tracking-wider bg-[#C9916C] text-white">
              Individual Development
            </span>
            <h3 class="font-serif text-2xl sm:text-3xl font-bold text-[#153D40]">
              Develop the English you use as an educator.
            </h3>
            <div class="space-y-3 text-sm sm:text-base text-[#667378] leading-relaxed">
              <p>
                One-to-one training can focus on individual communication needs, from classroom explanations to professional conversations and presentations.
              </p>
              <p>
                Sessions are structured around your pace and immediate professional commitments.
              </p>
            </div>
          </div>

          <div class="pt-6 mt-6 border-t border-[#E2DDD2]">
            <a
              href="/contact"
              class="inline-flex items-center text-sm font-semibold text-[#153D40] hover:text-[#C9916C] transition-colors"
            >
              <span>Enquire About One-to-One Training</span>
              <span class="ml-1.5 text-lg">→</span>
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- DELIVERY FORMATS -->
  <section class="py-20 bg-[#FAF8F5] border-t border-[#E2DDD2]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mx-auto text-center mb-14">
        <h2 class="font-serif text-3xl font-bold text-[#153D40] mb-4">
          Flexible Formats for Educators & Schools
        </h2>
        <p class="text-sm sm:text-base text-[#667378]">
          Training arrangements designed around academic calendars and personal teaching timetables.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {trainingFormats.map((fmt) => (
          <div class="bg-white p-6 rounded-xl border border-[#E2DDD2]">
            <h3 class="font-serif text-xl font-bold text-[#153D40] mb-2">{fmt.title}</h3>
            <p class="text-xs text-[#C9916C] font-medium mb-3">{fmt.tagline}</p>
            <p class="text-xs text-[#667378] leading-relaxed mb-4">{fmt.description}</p>
            <div class="text-[11px] text-[#212A32] border-t border-[#E2DDD2] pt-3">
              <strong class="text-[#153D40]">Best for:</strong> {fmt.idealFor}
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-white border-t border-[#E2DDD2]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-14">
        <h2 class="font-serif text-3xl font-bold text-[#153D40] mb-4">
          Educator Training FAQs
        </h2>
        <p class="text-sm sm:text-base text-[#667378]">
          Answers to common questions from teachers, coordinators, and school management.
        </p>
      </div>

      <FaqAccordion faqs={educatorFaqs} idPrefix="edu-faq" />
    </div>
  </section>

  <!-- FINAL CTA -->
  <CtaSection
    headline="Strengthen communication across your classroom and school."
    description="Discuss training priorities for yourself or your institution's teaching staff."
    primaryCtaText="Request an Educator Training Consultation"
    primaryCtaHref="/contact"
  />

</Layout>
